<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's defaults, which stop applying the moment this file
         exists — so they are repeated here rather than inherited.
         https://github.com/electron/electron-notarize#prerequisites -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- https://github.com/electron-userland/electron-builder/issues/3940 -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The DMG compiler arranges the window inside the images it builds by
         scripting Finder, which the hardened runtime blocks outright without
         this. Paired with NSAppleEventsUsageDescription in the mac config:
         the entitlement allows the Apple event, the description is what macOS
         shows the user when it asks them to approve it. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
