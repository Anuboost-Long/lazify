{
	"name": "lazify",
	"version": "1.0.0",
	"description": "GUI-driven desktop developer workflow launcher built with Electron, React, TypeScript, and Tailwind CSS.",
	"main": "dist-electron/main/main.js",
	"type": "commonjs",
	"scripts": {
		"dev": "concurrently -k -n RENDERER,ELECTRON_TS,PRELOAD,ELECTRON -c cyan,yellow,magenta,green \"npm:dev:renderer\" \"npm:dev:electron:ts\" \"npm:dev:preload\" \"npm:dev:electron\"",
		"dev:renderer": "vite",
		"dev:electron:ts": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
		"dev:electron": "wait-on tcp:5173 dist-electron/main/main.js dist-electron/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon .",
		"dev:website": "npm --prefix website run dev",
		"build": "npm run build:renderer && npm run build:electron",
		"build:renderer": "vite build",
		"build:electron": "tsc -p tsconfig.node.json && npm run build:preload",
		"package:mac": "npm run build && electron-builder --config electron-builder.mac.yml --publish never && npm run rebuild",
		"package:win": "npm run build && electron-builder --config electron-builder.win.yml --publish never",
		"package:linux": "npm run build && electron-builder --config electron-builder.linux.yml --publish never",
		"start": "electron .",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
		"make:lang": "tsx src/scripts/make-language.ts",
		"rebuild": "electron-rebuild -f -w node-pty",
		"mac:fix-electron": "node src/scripts/mac-fix-electron.mjs",
		"postinstall": "patch-package && electron-rebuild -f -w node-pty && node src/scripts/mac-fix-electron.mjs",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"build:preload": "node src/scripts/build-preload.mjs",
		"dev:preload": "node src/scripts/build-preload.mjs --watch"
	},
	"electronmon": {
		"patterns": [
			"!release",
			"!release/**/*"
		]
	},
	"dependencies": {
		"@ghostery/adblocker": "^2.18.1",
		"@ghostery/adblocker-electron": "^2.18.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"clsx": "^2.1.1",
		"electron-updater": "^6.8.9",
		"i18next": "^26.0.8",
		"iconoir-react": "^7.11.0",
		"jotai": "^2.19.1",
		"node-pty": "^1.1.0",
		"prettier": "^3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^17.0.6",
		"react-router-dom": "^7.14.2",
		"shiki": "^4.3.1",
		"unzipper": "^0.12.5"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.2.0",
		"@eslint/js": "^9.20.0",
		"@testing-library/dom": "^10.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.15.17",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@types/unzipper": "^0.10.11",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"electron": "^43.2.0",
		"electron-builder": "^26.8.1",
		"electronmon": "^2.0.2",
		"eslint": "9.20.0",
		"eslint-plugin-react-hooks": "^5",
		"globals": "^15",
		"jsdom": "^27.0.1",
		"patch-package": "^8.0.1",
		"postcss": "^8.5.3",
		"tailwindcss": "^3.4.17",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.26.0",
		"vite": "^7.3.6",
		"vitest": "^3",
		"wait-on": "^8.0.3"
	}
}
