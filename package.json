{
  "name": "lazify-chain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "chain dev",
    "build": "chain build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:web": "npm run build:formatter && vite",
    "build:web": "npm run build:formatter && tsc && vite build",
    "build:formatter": "rolldown -c node/formatter/rolldown.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@chain/sdk": "file:../chain-sdk/packages/sdk",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2",
    "i18next": "^26.4.2",
    "iconoir-react": "^7.12.1",
    "jotai": "^2.20.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@chain/cli": "file:../chain-sdk/packages/cli",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  },
  "chain": {
    "readOnlyFolders": [
      "~/Library/Application Support/lazify",
      "~/.claude/projects",
      "~/.codex/sessions",
      "~/.claude.json",
      "~/.codex/auth.json"
    ],
    "window": {
      "backgroundColor": "#0b1220",
      "showWhen": "firstPaint",
      "size": { "width": 1440, "height": 888 },
      "minSize": { "width": 1180, "height": 728 },
      "title": "Lazify",
      "tabFocus": "all"
    }
  }
}
